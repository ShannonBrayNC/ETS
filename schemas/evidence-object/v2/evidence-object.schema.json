{
  "$defs": {
    "ContractBinding": {
      "additionalProperties": false,
      "description": "A typed reference to a separately versioned evidence contract.",
      "properties": {
        "binding_type": {
          "enum": [
            "event",
            "claim",
            "provenance",
            "context",
            "relationship",
            "policy",
            "privacy",
            "verification"
          ],
          "title": "Binding Type",
          "type": "string"
        },
        "commitment": {
          "anyOf": [
            {
              "$ref": "#/$defs/DigestRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "contract_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Contract Id",
          "type": "string"
        },
        "subject_ref": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Subject Ref",
          "type": "string"
        }
      },
      "required": [
        "binding_type",
        "contract_id",
        "subject_ref"
      ],
      "title": "ContractBinding",
      "type": "object"
    },
    "DigestRef": {
      "additionalProperties": false,
      "properties": {
        "algorithm": {
          "const": "sha256",
          "default": "sha256",
          "title": "Algorithm",
          "type": "string"
        },
        "digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        }
      },
      "required": [
        "digest"
      ],
      "title": "DigestRef",
      "type": "object"
    },
    "EvidenceIdentityV2": {
      "additionalProperties": false,
      "properties": {
        "namespace": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Namespace",
          "type": "string"
        },
        "object_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Object Id",
          "type": "string"
        },
        "object_type": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Object Type",
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "object_id",
        "namespace",
        "object_type",
        "version"
      ],
      "title": "EvidenceIdentityV2",
      "type": "object"
    },
    "PolicyDescriptorV2": {
      "additionalProperties": false,
      "properties": {
        "audience": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Audience",
          "type": "array"
        },
        "policy_ref": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Policy Ref",
          "type": "string"
        },
        "purpose": {
          "anyOf": [
            {
              "maxLength": 256,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Purpose"
        }
      },
      "required": [
        "policy_ref"
      ],
      "title": "PolicyDescriptorV2",
      "type": "object"
    },
    "PrivacyDescriptorV2": {
      "additionalProperties": false,
      "properties": {
        "classification": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Classification",
          "type": "string"
        },
        "contains_pii": {
          "default": false,
          "title": "Contains Pii",
          "type": "boolean"
        },
        "disclosure_policy_ref": {
          "anyOf": [
            {
              "maxLength": 2048,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Disclosure Policy Ref"
        },
        "minimization_profile": {
          "anyOf": [
            {
              "maxLength": 256,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Minimization Profile"
        }
      },
      "required": [
        "classification"
      ],
      "title": "PrivacyDescriptorV2",
      "type": "object"
    },
    "ProofMaterialV2": {
      "additionalProperties": false,
      "description": "Non-identity proof attachment.\n\n``proof_type`` and ``material`` deliberately permit future proof profiles.\nThe entire collection is excluded from the canonical identity preimage.",
      "properties": {
        "material": {
          "additionalProperties": true,
          "title": "Material",
          "type": "object"
        },
        "profile": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Profile",
          "type": "string"
        },
        "proof_type": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Proof Type",
          "type": "string"
        }
      },
      "required": [
        "proof_type",
        "profile",
        "material"
      ],
      "title": "ProofMaterialV2",
      "type": "object"
    }
  },
  "$id": "https://lanternprotocol.org/schemas/ets/evidence-object/v2",
  "additionalProperties": false,
  "description": "Normative Evidence Object v2 envelope and identity boundary.",
  "properties": {
    "bindings": {
      "items": {
        "$ref": "#/$defs/ContractBinding"
      },
      "minItems": 1,
      "title": "Bindings",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "extensions": {
      "additionalProperties": true,
      "title": "Extensions",
      "type": "object"
    },
    "identity": {
      "$ref": "#/$defs/EvidenceIdentityV2"
    },
    "policies": {
      "default": [],
      "items": {
        "$ref": "#/$defs/PolicyDescriptorV2"
      },
      "title": "Policies",
      "type": "array"
    },
    "privacy": {
      "anyOf": [
        {
          "$ref": "#/$defs/PrivacyDescriptorV2"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "proof_material": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ProofMaterialV2"
      },
      "title": "Proof Material",
      "type": "array"
    },
    "schema_id": {
      "const": "https://lanternprotocol.org/schemas/ets/evidence-object/v2",
      "default": "https://lanternprotocol.org/schemas/ets/evidence-object/v2",
      "title": "Schema Id",
      "type": "string"
    }
  },
  "required": [
    "identity",
    "created_at",
    "bindings"
  ],
  "title": "EvidenceObjectV2",
  "type": "object"
}
