{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lanternprotocol.net/schemas/qualification/v1/cross-product-reuse.schema.json",
  "title": "ETS HQP Cross-Product Reuse Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "reuse_id",
    "product_name",
    "target_class_id",
    "profile_id",
    "profile_version",
    "source_contract",
    "bindings",
    "product_specific_extensions",
    "physical_exit_gate",
    "claim_boundary"
  ],
  "properties": {
    "schema_version": {"const": "ets.hqp-cross-product-reuse.v1"},
    "reuse_id": {"type": "string", "minLength": 3},
    "product_name": {"type": "string", "minLength": 1},
    "target_class_id": {"type": "string", "minLength": 1},
    "profile_id": {"type": "string", "minLength": 3},
    "profile_version": {"type": "string", "minLength": 1},
    "source_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "path", "commit_sha", "issue_refs"],
      "properties": {
        "repository": {"type": "string", "minLength": 3},
        "path": {"type": "string", "minLength": 1},
        "commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"},
        "issue_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "bindings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_field", "hqp_target", "evidence_role"],
        "properties": {
          "source_field": {"type": "string", "minLength": 1},
          "hqp_target": {"type": "string", "minLength": 1},
          "evidence_role": {"type": "string", "minLength": 1},
          "required": {"type": "boolean", "default": true},
          "notes": {"type": ["string", "null"]}
        }
      }
    },
    "product_specific_extensions": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "physical_exit_gate": {"type": "string", "minLength": 1},
    "claim_boundary": {
      "const": "cross_product_hqp_reuse_not_physical_qualification_truth_completeness_compliance_or_safety_proof"
    }
  }
}
