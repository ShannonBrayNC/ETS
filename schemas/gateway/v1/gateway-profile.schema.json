{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lanternprotocol.org/schemas/ets/gateway/v1/profile",
  "title": "ETS Gateway Profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["profile_id","schema_version","conformance_class","deployment","zones","network_controls","evidence_boundary","core_boundary","transport_security","protocols","identity","signer","platform","time","resource_bounds","observability","claims","qualification_objectives","required_documents"],
  "properties": {
    "profile_id": {"const": "ets.gateway.reference.pilot.v1"},
    "schema_version": {"const": "ets.gateway.profile.v1"},
    "conformance_class": {"const": "pilot"},
    "deployment": {"type":"object","additionalProperties":false,"required":["default_mode","modes","availability_authority"],"properties":{"default_mode":{"const":"collector"},"availability_authority":{"const":false},"modes":{"type":"object","additionalProperties":false,"required":["collector","passive_mirror","routed_inline"],"properties":{"collector":{"$ref":"#/$defs/modeEnabled"},"passive_mirror":{"$ref":"#/$defs/modeExperimental"},"routed_inline":{"$ref":"#/$defs/modeDeferred"}}}}},
    "zones": {"type":"object","additionalProperties":false,"required":["management","collection","upstream","observation"],"properties":{"management":{"$ref":"#/$defs/zone"},"collection":{"$ref":"#/$defs/zone"},"upstream":{"$ref":"#/$defs/zone"},"observation":{"$ref":"#/$defs/zone"}}},
    "network_controls": {"type":"object","additionalProperties":false,"required":["ipv4_forwarding","ipv6_forwarding","nat","interzone_bridge","firewall_policy"],"properties":{"ipv4_forwarding":{"const":false},"ipv6_forwarding":{"const":false},"nat":{"const":false},"interzone_bridge":{"const":false},"firewall_policy":{"const":"default_deny_explicit_allow"}}},
    "evidence_boundary": {"type":"object","additionalProperties":false,"required":["privacy_before_commit","raw_evidence_retained","digest_basis","transformation_provenance","completeness_claim"],"properties":{"privacy_before_commit":{"const":true},"raw_evidence_retained":{"const":false},"digest_basis":{"const":"declared_evidence_representation"},"transformation_provenance":{"const":true},"completeness_claim":{"const":false}}},
    "core_boundary": {"type":"object","additionalProperties":false,"required":["api","reimplement_protocol_semantics","local_history_rewritable_by_upstream"],"properties":{"api":{"const":"ets.core.api"},"reimplement_protocol_semantics":{"const":false},"local_history_rewritable_by_upstream":{"const":false}}},
    "transport_security": {"type":"object","additionalProperties":false,"required":["prohibited_versions","minimum_compatible","preferred","mtls_preferred"],"properties":{"prohibited_versions":{"type":"array","uniqueItems":true,"items":{"enum":["SSLv2","SSLv3","TLS1.0","TLS1.1"]},"minItems":4,"maxItems":4},"minimum_compatible":{"const":"TLS1.2"},"preferred":{"const":"TLS1.3"},"mtls_preferred":{"const":true}}},
    "protocols": {"type":"object","additionalProperties":false,"required":["https_webhook","syslog","otlp","file"],"properties":{"https_webhook":{"$ref":"#/$defs/protocol"},"syslog":{"$ref":"#/$defs/syslog"},"otlp":{"$ref":"#/$defs/otlp"},"file":{"$ref":"#/$defs/protocol"}}},
    "identity": {"type":"object","additionalProperties":false,"required":["network_location_is_identity","transport_and_payload_identity_separate","tenant_scope_server_authorized","syslog_tls_identity_equals_hostname"],"properties":{"network_location_is_identity":{"const":false},"transport_and_payload_identity_separate":{"const":true},"tenant_scope_server_authorized":{"const":true},"syslog_tls_identity_equals_hostname":{"const":false}}},
    "signer": {"type":"object","additionalProperties":false,"required":["development_software_allowed","pilot_hardware_backed_required","private_key_exportable_to_app","purpose_separated_keys"],"properties":{"development_software_allowed":{"const":true},"pilot_hardware_backed_required":{"const":true},"private_key_exportable_to_app":{"const":false},"purpose_separated_keys":{"const":true}}},
    "platform": {"type":"object","additionalProperties":false,"required":["architecture","min_memory_gib","reference_memory_gib","min_nvme_gib","tpm2_required","uefi_secure_boot_required","preferred_physical_nics"],"properties":{"architecture":{"const":"x86_64"},"min_memory_gib":{"type":"integer","minimum":16},"reference_memory_gib":{"type":"integer","minimum":32},"min_nvme_gib":{"type":"integer","minimum":1024},"tpm2_required":{"const":true},"uefi_secure_boot_required":{"const":true},"preferred_physical_nics":{"type":"integer","minimum":4}}},
    "time": {"type":"object","additionalProperties":false,"required":["source_and_receipt_time_separate","monotonic_for_durations","ntpv4_supported","nts_preferred","clock_quality_required","authenticated_time_proves_correct_utc"],"properties":{"source_and_receipt_time_separate":{"const":true},"monotonic_for_durations":{"const":true},"ntpv4_supported":{"const":true},"nts_preferred":{"const":true},"clock_quality_required":{"const":true},"authenticated_time_proves_correct_utc":{"const":false}}},
    "resource_bounds": {"type":"object","additionalProperties":false,"required":["payload","decompressed_payload","request_duration","concurrency","queue_items","queue_bytes","storage_watermarks","explicit_backpressure"],"properties":{"payload":{"const":true},"decompressed_payload":{"const":true},"request_duration":{"const":true},"concurrency":{"const":true},"queue_items":{"const":true},"queue_bytes":{"const":true},"storage_watermarks":{"const":true},"explicit_backpressure":{"const":true}}},
    "observability": {"type":"object","additionalProperties":false,"required":["node_health_separate_from_verification","raw_payload_logging","secret_logging","collection_gap_state","clock_quality_state"],"properties":{"node_health_separate_from_verification":{"const":true},"raw_payload_logging":{"const":false},"secret_logging":{"const":false},"collection_gap_state":{"const":true},"clock_quality_state":{"const":true}}},
    "claims": {"type":"object","additionalProperties":false,"required":["truth","complete_observation","legal_admissibility","regulatory_compliance","source_system_security"],"properties":{"truth":{"const":false},"complete_observation":{"const":false},"legal_admissibility":{"const":false},"regulatory_compliance":{"const":false},"source_system_security":{"const":false}}},
    "qualification_objectives": {"type":"object","additionalProperties":false,"required":["measured","sla","sustained_events_per_second","burst_events_per_second","burst_seconds","max_stream_object_gib","offline_backlog_days"],"properties":{"measured":{"const":false},"sla":{"const":false},"sustained_events_per_second":{"type":"integer","minimum":1},"burst_events_per_second":{"type":"integer","minimum":1},"burst_seconds":{"type":"integer","minimum":1},"max_stream_object_gib":{"type":"integer","minimum":1},"offline_backlog_days":{"type":"integer","minimum":1}}},
    "required_documents": {"type":"array","uniqueItems":true,"minItems":9,"items":{"type":"string","minLength":1}}
  },
  "$defs": {
    "modeEnabled": {"type":"object","additionalProperties":false,"required":["enabled","status"],"properties":{"enabled":{"const":true},"status":{"const":"normative"}}},
    "modeExperimental": {"type":"object","additionalProperties":false,"required":["enabled","status"],"properties":{"enabled":{"const":true},"status":{"const":"experimental"}}},
    "modeDeferred": {"type":"object","additionalProperties":false,"required":["enabled","status"],"properties":{"enabled":{"const":false},"status":{"const":"deferred"}}},
    "zone": {"type":"object","additionalProperties":false,"required":["required","default_route","management_listener","ingestion_listener","sync_listener"],"properties":{"required":{"type":"boolean"},"default_route":{"type":"boolean"},"management_listener":{"type":"boolean"},"ingestion_listener":{"type":"boolean"},"sync_listener":{"type":"boolean"}}},
    "protocol": {"type":"object","additionalProperties":false,"required":["enabled","production_tls_required"],"properties":{"enabled":{"type":"boolean"},"production_tls_required":{"type":"boolean"}}},
    "syslog": {"type":"object","additionalProperties":false,"required":["enabled","preferred_format","preferred_transport","tls_default_port","udp_compatibility","udp_lower_assurance","transport_identity_separate_from_hostname","rfc5425_full_conformance_claim"],"properties":{"enabled":{"const":true},"preferred_format":{"const":"RFC5424"},"preferred_transport":{"const":"TLS"},"tls_default_port":{"const":6514},"udp_compatibility":{"const":true},"udp_lower_assurance":{"const":true},"transport_identity_separate_from_hostname":{"const":true},"rfc5425_full_conformance_claim":{"const":false}}},
    "otlp": {"type":"object","additionalProperties":false,"required":["enabled","transports","signals"],"properties":{"enabled":{"const":true},"transports":{"type":"array","uniqueItems":true,"minItems":1,"items":{"enum":["grpc","http/protobuf"]}},"signals":{"type":"array","uniqueItems":true,"minItems":1,"items":{"enum":["logs","metrics","traces"]}}}}
  }
}
