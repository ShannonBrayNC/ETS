{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lanternprotocol.net/schemas/ranger/decision-event.v0.1.schema.json",
  "title": "ETS Ranger Decision Event v0.1",
  "description": "Research schema for reconstructing a consequential Ranger decision with explicit epistemic state and optional cyber-physical state binding.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "event_id", "mission_id", "ranger_id", "occurred_at", "subject_context", "decision", "evidence"],
  "properties": {
    "schema_version": {"const": "ranger.decision-event.v0.1"},
    "event_id": {"type": "string", "minLength": 1},
    "mission_id": {"type": "string", "minLength": 1},
    "ranger_id": {"type": "string", "minLength": 1},
    "occurred_at": {"type": "string", "format": "date-time"},
    "subject_context": {"type": "array", "items": {"$ref": "#/$defs/subjectContext"}},
    "decision": {"$ref": "#/$defs/decision"},
    "cyber_physical_state": {"$ref": "https://lanternprotocol.net/schemas/ranger/cyber-physical-state.v0.1.schema.json"},
    "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidenceRef"}},
    "previous_event_digest": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
    "event_digest": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
    "signature": {"$ref": "#/$defs/signature"}
  },
  "$defs": {
    "epistemicState": {"type": "string", "enum": ["KNOWN", "NOT_OBSERVED", "NOT_AVAILABLE", "UNKNOWN", "INDETERMINATE", "CONTRADICTED"]},
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim_id", "kind", "state", "source_refs"],
      "properties": {
        "claim_id": {"type": "string", "minLength": 1},
        "kind": {"type": "string", "minLength": 1},
        "value": {},
        "state": {"$ref": "#/$defs/epistemicState"},
        "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "threshold": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "mechanism": {"type": ["string", "null"]},
        "source_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "reason": {"type": ["string", "null"]},
        "contradicts_claim_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      },
      "allOf": [
        {"if": {"properties": {"state": {"const": "KNOWN"}}}, "then": {"required": ["value"]}},
        {"if": {"properties": {"state": {"enum": ["NOT_OBSERVED", "NOT_AVAILABLE", "UNKNOWN", "INDETERMINATE", "CONTRADICTED"]}}}, "then": {"required": ["reason"]}}
      ]
    },
    "subjectContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject_id", "subject_scope", "claims"],
      "properties": {
        "subject_id": {"type": "string", "minLength": 1},
        "subject_scope": {"type": "string", "enum": ["MISSION_PSEUDONYM", "REGISTERED_PRINCIPAL", "EXTERNAL_CLAIM_ONLY"]},
        "claims": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/claim"}}
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision_id", "policy_id", "selected_action", "participating_claim_ids"],
      "properties": {
        "decision_id": {"type": "string", "minLength": 1},
        "policy_id": {"type": "string", "minLength": 1},
        "candidate_actions": {"type": "array", "items": {"type": "string"}},
        "selected_action": {"type": "string", "minLength": 1},
        "authorization_state": {"type": "string", "enum": ["AUTHORIZED", "DENIED", "NOT_REQUIRED", "UNKNOWN"]},
        "participating_claim_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "excluded_claim_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "decision_reason": {"type": ["string", "null"]}
      }
    },
    "evidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_id", "evidence_type", "source_id", "digest"],
      "properties": {
        "evidence_id": {"type": "string", "minLength": 1},
        "evidence_type": {"type": "string", "minLength": 1},
        "source_id": {"type": "string", "minLength": 1},
        "captured_at": {"type": ["string", "null"], "format": "date-time"},
        "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "uri": {"type": ["string", "null"]}
      }
    },
    "signature": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["algorithm", "key_id", "value"],
      "properties": {
        "algorithm": {"type": "string", "minLength": 1},
        "key_id": {"type": "string", "minLength": 1},
        "value": {"type": "string", "minLength": 1}
      }
    }
  }
}
