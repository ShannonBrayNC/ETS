{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lanternprotocol.net/schemas/ranger/vectorrail-vrx-acceptance.v0.1.schema.json",
  "title": "ETS VectorRail VRX Laboratory Acceptance Record v0.1",
  "description": "Machine-verifiable qualification record for the low-energy mechanically captive VectorRail/VRX consequence-custody laboratory module.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "acceptance_id", "vrx_device_id", "configuration_digest", "reviewed_at", "reviewer_id", "gates", "dry_runs", "final_safe_state", "verifier", "qualification"],
  "properties": {
    "schema_version": {"const": "ranger.vectorrail-vrx-acceptance.v0.1"},
    "acceptance_id": {"type": "string", "minLength": 1},
    "vrx_device_id": {"type": "string", "minLength": 1},
    "configuration_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "reviewed_at": {"type": "string", "format": "date-time"},
    "reviewer_id": {"type": "string", "minLength": 1},
    "gates": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {"$ref": "#/$defs/gate"}
    },
    "dry_runs": {
      "type": "array",
      "minItems": 7,
      "items": {"$ref": "#/$defs/dryRun"}
    },
    "final_safe_state": {"type": "string", "enum": ["CONFIRMED", "NOT_CONFIRMED", "UNKNOWN"]},
    "verifier": {"$ref": "#/$defs/verifier"},
    "qualification": {"type": "string", "enum": ["QUALIFIED", "NOT_QUALIFIED"]},
    "notes": {"type": ["string", "null"]}
  },
  "$defs": {
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gate_id", "status", "checks"],
      "properties": {
        "gate_id": {"type": "string", "enum": ["G0", "G1", "G2", "G3", "G4", "G5", "G6"]},
        "status": {"type": "string", "enum": ["PASS", "FAIL", "NOT_RUN"]},
        "checks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["check_id", "status"],
            "properties": {
              "check_id": {"type": "string", "minLength": 1},
              "status": {"type": "string", "enum": ["PASS", "FAIL", "NOT_RUN"]},
              "evidence_ref": {"type": ["string", "null"]},
              "note": {"type": ["string", "null"]}
            }
          }
        }
      }
    },
    "dryRun": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scenario", "status", "trial_ref"],
      "properties": {
        "scenario": {"type": "string", "enum": ["BASELINE", "INTERLOCK_REJECTION", "CONTROLLER_RESET_FAULT", "REQUIRED_SENSOR_UNAVAILABLE", "CONTRADICTORY_OBSERVATIONS", "BLOCKED_MECHANICAL_RESPONSE", "FINAL_SAFE_STATE_FAILURE"]},
        "status": {"type": "string", "enum": ["PASS", "FAIL", "NOT_RUN"]},
        "trial_ref": {"type": ["string", "null"]},
        "note": {"type": ["string", "null"]}
      }
    },
    "verifier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "status"],
      "properties": {
        "profile": {"const": "ets.vectorrail.acceptance-verifier.v0.1"},
        "status": {"type": "string", "enum": ["VERIFIED", "FAILED", "NOT_RUN"]},
        "evidence_package_digest": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
        "reason": {"type": ["string", "null"]}
      }
    }
  }
}
