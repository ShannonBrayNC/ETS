{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lanternprotocol.net/schemas/ets/connector-package.v1.json",
  "title": "ETS Connector Package Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "package_id",
    "package_version",
    "connector_id",
    "publisher",
    "provenance",
    "compatibility",
    "definition_path",
    "settings_schema_path",
    "entrypoints",
    "files",
    "package_content_sha256"
  ],
  "properties": {
    "schema_version": { "const": "ets.connector.package.v1" },
    "package_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$" },
    "package_version": { "type": "string", "minLength": 1, "maxLength": 64 },
    "connector_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$" },
    "publisher": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "publisher_class", "qualification_state"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "publisher_class": {
          "enum": ["lantern_builtin", "lantern_qualified_third_party", "community_unqualified"]
        },
        "qualification_state": { "enum": ["qualified", "unqualified", "revoked"] }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository_url", "source_revision"],
      "properties": {
        "repository_url": { "type": "string", "format": "uri" },
        "source_revision": { "type": "string", "minLength": 7, "maxLength": 128 },
        "build_ref": { "type": ["string", "null"], "minLength": 1, "maxLength": 200 }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sdk_contract_version", "gateway_host_versions", "capture_envelope_versions"],
      "properties": {
        "sdk_contract_version": { "type": "string", "minLength": 1 },
        "gateway_host_versions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": { "type": "string", "minLength": 1 }
        },
        "capture_envelope_versions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "definition_path": { "$ref": "#/$defs/safePath" },
    "settings_schema_path": { "$ref": "#/$defs/safePath" },
    "entrypoints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter", "conformance"],
      "properties": {
        "adapter": { "$ref": "#/$defs/entryPoint" },
        "conformance": { "$ref": "#/$defs/entryPoint" }
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": { "$ref": "#/$defs/safePath" },
          "sha256": { "$ref": "#/$defs/sha256" }
        }
      }
    },
    "package_content_sha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "safePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*(?:^|/)\\.(?:/|$)).+$"
    },
    "entryPoint": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_.]*:[A-Za-z_][A-Za-z0-9_]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
