{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lanternprotocol.net/schemas/connectors/v1/native/webhook-settings.schema.json",
  "title": "ETS Gateway native webhook settings",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "bind_host": {"type": "string", "minLength": 1, "maxLength": 255},
    "bind_port": {"type": "integer", "minimum": 1, "maximum": 65535},
    "max_body_bytes": {"type": "integer", "minimum": 1, "maximum": 67108864},
    "max_concurrency": {"type": "integer", "minimum": 1, "maximum": 10000},
    "request_timeout_seconds": {"type": "number", "exclusiveMinimum": 0, "maximum": 300}
  }
}
