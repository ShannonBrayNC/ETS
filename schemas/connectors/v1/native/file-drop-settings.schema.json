{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lanternprotocol.net/schemas/connectors/v1/native/file-drop-settings.schema.json",
  "title": "ETS Gateway native file/drop settings",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "intake_root": {"type": "string", "minLength": 1, "maxLength": 4096},
    "max_concurrent_submissions": {"type": "integer", "minimum": 1, "maximum": 10000},
    "max_object_bytes": {"type": "integer", "minimum": 1, "maximum": 1099511627776},
    "read_chunk_bytes": {"type": "integer", "minimum": 1, "maximum": 16777216},
    "graceful_shutdown_seconds": {"type": "number", "exclusiveMinimum": 0, "maximum": 3600}
  }
}
