{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lanternprotocol.net/schemas/connectors/v1/enterprise/microsoft-entra-directory-delta-settings.schema.json",
  "title": "ETS Microsoft Entra Directory Delta connector settings",
  "type": "object",
  "additionalProperties": false,
  "required": ["tenant_profile_id", "collection"],
  "properties": {
    "tenant_profile_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "collection": {
      "type": "string",
      "enum": ["users", "groups"]
    },
    "request_timeout_seconds": {
      "type": "number",
      "minimum": 0.1,
      "maximum": 60,
      "default": 30
    },
    "maximum_response_bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2097152,
      "default": 2097152
    }
  }
}
