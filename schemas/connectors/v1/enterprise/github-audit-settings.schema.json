{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lanternprotocol.net/schemas/connectors/v1/enterprise/github-audit-settings.schema.json",
  "title": "ETS GitHub organization audit connector settings",
  "type": "object",
  "additionalProperties": false,
  "required": ["organization"],
  "properties": {
    "organization": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9.-]{0,98}[A-Za-z0-9])?$"
    },
    "api_base_url": {
      "type": "string",
      "format": "uri",
      "minLength": 8,
      "maxLength": 500
    },
    "api_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    },
    "include": {
      "type": "string",
      "enum": ["web", "git", "all"]
    },
    "request_timeout_seconds": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 60
    }
  }
}
