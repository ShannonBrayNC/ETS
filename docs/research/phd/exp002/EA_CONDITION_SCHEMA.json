{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lanternprotocol.net/research/exp002/ea-condition.schema.json",
  "title": "EXP-002 Condition E — Evidence Architecture Representation",
  "type": "object",
  "additionalProperties": false,
  "required": ["scenario_id", "evidence_objects", "relationships", "verification_profile", "verification_results", "normalized_output"],
  "properties": {
    "scenario_id": {"type": "string", "pattern": "^S[0-9]{2}$"},
    "evidence_objects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "producer_ref", "claim_type", "payload_ref", "epistemic_state"],
        "properties": {
          "id": {"type": "string"},
          "producer_ref": {"type": "string"},
          "claim_type": {"type": "string"},
          "payload_ref": {"type": ["string", "null"]},
          "epistemic_state": {
            "enum": ["SUPPORTED", "ASSERTED", "UNKNOWN", "NOT_AVAILABLE", "INDETERMINATE", "CONTRADICTED", "NOT_OBSERVED", "NOT_APPLICABLE"]
          },
          "event_time": {"type": ["string", "null"]},
          "integrity": {"type": "object"},
          "identity": {"type": "object"},
          "custody": {"type": "object"},
          "freshness": {"type": "object"},
          "policy_refs": {"type": "array", "items": {"type": "string"}},
          "nonclaims": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "relation_type", "from_ref", "to_ref", "producer_ref", "epistemic_state", "verification_state"],
        "properties": {
          "id": {"type": "string"},
          "relation_type": {
            "enum": ["OBSERVATION", "DERIVATION", "INFERENCE", "ATTRIBUTION", "AUTHORITY", "STANDING", "DECISION", "REQUEST", "ACCEPTANCE", "EXECUTION", "CUSTODY", "RESULT_OBSERVATION", "CONSEQUENCE", "CONTRADICTION", "DEPENDENCY"]
          },
          "from_ref": {"type": "string"},
          "to_ref": {"type": "string"},
          "producer_ref": {"type": "string"},
          "epistemic_state": {
            "enum": ["SUPPORTED", "ASSERTED", "UNKNOWN", "NOT_AVAILABLE", "INDETERMINATE", "CONTRADICTED", "NOT_OBSERVED", "NOT_APPLICABLE"]
          },
          "verification_state": {"type": "object"},
          "source_refs": {"type": "array", "items": {"type": "string"}},
          "nonclaims": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "verification_profile": {
      "type": "object",
      "required": ["dimensions", "non_collapse_rules", "policy_refs"],
      "properties": {
        "dimensions": {
          "type": "array",
          "items": {
            "enum": [
              "STRUCTURAL_INTEGRITY",
              "CRYPTOGRAPHIC_INTEGRITY",
              "PRODUCER_IDENTITY",
              "PROVENANCE_DERIVATION",
              "CUSTODY_CONTINUITY",
              "FRESHNESS_CURRENTNESS",
              "AUTHORITY_POLICY",
              "HISTORICAL_STANDING",
              "SCOPED_COMPLETENESS",
              "REQUESTED_ACTION",
              "EXECUTED_ACTION",
              "RESULT_OBSERVATION",
              "CONSEQUENCE_LINKAGE",
              "VERIFIER_TRUST",
              "POLICY_FRESHNESS",
              "NONCLAIM_DISCIPLINE"
            ]
          },
          "uniqueItems": true
        },
        "non_collapse_rules": {"type": "array", "items": {"type": "string"}},
        "policy_refs": {"type": "array", "items": {"type": "string"}}
      }
    },
    "verification_results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["dimension", "state", "source_refs", "nonclaims"],
        "properties": {
          "dimension": {"type": "string"},
          "state": {"type": "string"},
          "source_refs": {"type": "array", "items": {"type": "string"}},
          "policy_refs": {"type": "array", "items": {"type": "string"}},
          "nonclaims": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "normalized_output": {
      "$ref": "NORMALIZED_CONCLUSION_SCHEMA.json"
    }
  }
}
