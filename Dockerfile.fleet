FROM python:3.12-slim-bookworm

WORKDIR /app

RUN apt-get update \
    && apt-get upgrade --yes --no-install-recommends \
    && rm -rf /var/lib/apt/lists/* \
    && addgroup --system ets \
    && adduser --system --ingroup ets --home /nonexistent --no-create-home ets

COPY pyproject.toml README.md ./
COPY ets ./ets

RUN python -m pip install --no-cache-dir -e ".[fleet]"

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV ETS_FLEET_RUNTIME=production

USER ets
EXPOSE 8080

CMD ["python", "-m", "ets.fleet.production_entrypoint"]
