{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lanternprotocol.net/schemas/ranger/vectorrail-vrx-independent-validation-report.v0.1.schema.json",
  "title": "VectorRail/VRX Independent Validation Report v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "validation_id",
    "validator",
    "subject",
    "environment",
    "implementation",
    "challenge_results",
    "summary",
    "approval"
  ],
  "properties": {
    "schema_version": {
      "const": "ranger.vectorrail-vrx-independent-validation-report.v0.1"
    },
    "validation_id": {
      "type": "string",
      "minLength": 1
    },
    "validator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "conflict_disclosure",
        "independence_statement",
        "inspected_reference_source_before_freeze"
      ],
      "properties": {
        "identity": {"type": "string", "minLength": 1},
        "organization": {"type": ["string", "null"]},
        "role": {"type": ["string", "null"]},
        "conflict_disclosure": {"type": "string", "minLength": 1},
        "independence_statement": {"type": "string", "minLength": 1},
        "inspected_reference_source_before_freeze": {"type": "boolean"}
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "source_commit",
        "package_digest",
        "package_schema",
        "challenge_manifest"
      ],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "package_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "package_schema": {"type": "string", "minLength": 1},
        "challenge_manifest": {"type": "string", "minLength": 1}
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operating_system",
        "architecture",
        "language",
        "runtime_version",
        "dependencies",
        "network_used"
      ],
      "properties": {
        "operating_system": {"type": "string", "minLength": 1},
        "architecture": {"type": "string", "minLength": 1},
        "language": {"type": "string", "minLength": 1},
        "runtime_version": {"type": "string", "minLength": 1},
        "dependencies": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "network_used": {"type": "boolean"},
        "notes": {"type": ["string", "null"]}
      }
    },
    "implementation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_reference",
        "copied_reference_source",
        "public_materials",
        "clarifications"
      ],
      "properties": {
        "source_reference": {"type": "string", "minLength": 1},
        "copied_reference_source": {"const": false},
        "public_materials": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "clarifications": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["question", "answer", "source"],
            "properties": {
              "question": {"type": "string", "minLength": 1},
              "answer": {"type": "string", "minLength": 1},
              "source": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "challenge_results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "challenge_id",
          "observed_package_conclusion",
          "passed"
        ],
        "properties": {
          "challenge_id": {"type": "string", "pattern": "^VRX-CR-[0-9]{3}$"},
          "observed_package_conclusion": {"type": "string", "minLength": 1},
          "observed_chain_conclusion": {"type": ["string", "null"]},
          "passed": {"type": "boolean"},
          "diagnostics": {"type": ["string", "null"]}
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "all_required_challenges_passed",
        "mismatches",
        "limitations",
        "residual_risks"
      ],
      "properties": {
        "all_required_challenges_passed": {"type": "boolean"},
        "mismatches": {
          "type": "array",
          "items": {"type": "string"}
        },
        "limitations": {
          "type": "array",
          "items": {"type": "string"}
        },
        "residual_risks": {
          "type": "array",
          "items": {"type": "string"}
        }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "reviewed_at", "record_reference"],
      "properties": {
        "decision": {
          "enum": ["APPROVE", "REJECT", "INDETERMINATE"]
        },
        "reviewed_at": {
          "type": "string",
          "format": "date-time"
        },
        "record_reference": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
