FROM python:3.12-slim

WORKDIR /app

COPY pyproject.toml README.md ./
COPY ets ./ets
COPY edge-demo/entrypoint.py ./edge-demo/entrypoint.py

RUN python -m pip install --no-cache-dir -e ".[dev]"

ENV ETS_EDGE_DATA_DIR=/var/lib/ets \
    ETS_STORAGE_PROVIDER=sqlite \
    ETS_SQLITE_PATH=/var/lib/ets/edge.db \
    ETS_LOG_ID=ets-edge-virtual-demo \
    ETS_REDACTION_PROFILE=none \
    ETS_AUTH_MODE=local_api_key \
    ETS_SIGNING_MODE=ed25519 \
    ETS_SIGNING_PUBLIC_KEY_ID=ets-edge-virtual-demo-key

VOLUME ["/var/lib/ets"]
EXPOSE 8000

CMD ["python", "edge-demo/entrypoint.py"]
