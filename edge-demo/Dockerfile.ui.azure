FROM node:22-alpine AS build

WORKDIR /ui

COPY ets/explorer-ui/package.json ets/explorer-ui/package-lock.json ./
RUN npm ci

COPY ets/explorer-ui/ ./

ARG VITE_ETS_API_BASE_URL=
ARG VITE_ETS_SURFACE_PROFILE=edge
ENV VITE_ETS_API_BASE_URL=${VITE_ETS_API_BASE_URL} \
    VITE_ETS_SURFACE_PROFILE=${VITE_ETS_SURFACE_PROFILE}
RUN npm run build

FROM nginx:1.27-alpine

COPY edge-demo/nginx.azure-main.conf /etc/nginx/nginx.conf
COPY edge-demo/nginx.azure.conf /etc/nginx/conf.d/default.conf
COPY --from=build /ui/dist /usr/share/nginx/html

USER nginx
EXPOSE 8080
