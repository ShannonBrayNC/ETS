FROM node:22-alpine AS build

WORKDIR /ui

COPY ets/explorer-ui/package.json ets/explorer-ui/package-lock.json ./
RUN npm ci

COPY ets/explorer-ui/ ./

# Keep Edge Virtual additive: tailor only the built demo image while leaving the
# shared Explorer source unchanged.
RUN sed -i "s/ready?.ready/ready?.status === 'ready'/g" src/App.jsx \
    && sed -i "s/ETS Explorer RC Demo/ETS Edge Virtual Demo/g" src/App.jsx \
    && sed -i "/<ElectionRcDemo showTamperDemo={showTamperDemo} setShowTamperDemo={setShowTamperDemo} \/>/d" src/App.jsx

ARG VITE_ETS_API_BASE_URL=
ENV VITE_ETS_API_BASE_URL=${VITE_ETS_API_BASE_URL}
RUN npm run build

FROM nginx:1.27-alpine

COPY edge-demo/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /ui/dist /usr/share/nginx/html

EXPOSE 80
