FROM python:3.12-slim

WORKDIR /app

COPY pyproject.toml README.md ./
COPY ets ./ets

RUN python -m pip install --no-cache-dir -e ".[edge]"

ENV ETS_EDGE_UPSTREAM_DB=/var/lib/ets-upstream/upstream.db

EXPOSE 8002

CMD ["python", "-m", "uvicorn", "ets.edge.upstream_demo:app", "--host", "0.0.0.0", "--port", "8002"]
